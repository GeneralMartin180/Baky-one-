# Optional local server port. Vercel uses its managed function runtime.
PORT=3000

# Optional licensed web search provider. The basic search sources need no key.
# Keep API keys on the server only; never use a VITE_ prefix.
BRAVE_SEARCH_API_KEY=

# Optional server networking. TOR_PROXY_URL takes priority over HTTP proxy settings.
# If Tor is required but unavailable, requests fail instead of falling back to direct.
# For remote DNS use socks5h://127.0.0.1:9050.
SEARCH_NETWORK_MODE=direct
TOR_PROXY_URL=
PROXY_URL=
HTTP_PROXY=
HTTPS_PROXY=
